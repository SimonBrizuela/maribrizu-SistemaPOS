{
  "indexes": [
    {
      "//": "Catálogo filtrado por rubro y ordenado. Sin este índice la tienda cae a traer 300 productos y ordenarlos en el navegador, que anda pero es lento y no pagina.",
      "collectionGroup": "tienda_productos",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "rubro",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "orden",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "__name__",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Tiras de la portada y paginado por rubro: seis productos de un rubro a partir de un punto al azar DENTRO de ese rubro. El orden global mezcla los rubros, asi que no sirve para saltar.",
      "collectionGroup": "tienda_productos",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "rubro",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "orden_rubro",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Destacados de la portada, en el orden del catálogo.",
      "collectionGroup": "tienda_productos",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "destacado",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "orden",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Búsqueda por palabra, con lo que hay en stock primero.",
      "collectionGroup": "tienda_productos",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "tokens",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "orden",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Tablero de pedidos del panel: los nuevos arriba.",
      "collectionGroup": "tienda_pedidos",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "estado",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "creado",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Sugerencias del buscador acotadas al rubro que se esta mirando.",
      "collectionGroup": "tienda_productos",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "rubro",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "nombre_busqueda",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Segunda fila de filtros: un subrubro dentro de un rubro, paginado. Sin este indice la tienda cae a traer 300 y ordenar en el navegador.",
      "collectionGroup": "tienda_productos",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "rubro",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "sub_rubro",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "orden_rubro",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "__name__",
          "order": "ASCENDING"
        }
      ]
    }
  ],
  "fieldOverrides": []
}
