rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
//  REGLAS DE SEGURIDAD — mari-d7c71
// ───────────────────────────────────────────────────────────────────────────
//  Antes toda la base era `allow read, write: if true`. Como la apiKey del
//  cliente viaja en el bundle público de la webapp, eso equivalía a dejar la
//  contabilidad, los datos de clientes, los certificados de ARCA y la terminal
//  remota de las PCs abiertos a cualquiera con un navegador.
//
//  IMPORTANTE — el POS no se ve afectado por este archivo. Se conecta con el
//  Admin SDK (service account), que salta las reglas por diseño. Las PCs de la
//  librería siguen sincronizando igual sin tocarles nada.
//
//  Estos permisos aplican únicamente a la webapp de gestión.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────
    // El ingreso es con Google, así que CUALQUIERA con una cuenta de Google
    // puede autenticarse contra este proyecto. Por eso `request.auth != null`
    // no alcanza como permiso: hace falta un custom claim explícito, que solo
    // se setea con el Admin SDK desde scripts/auth_admin.py y viaja firmado
    // dentro del ID token (el cliente no puede fabricárselo).
    function authorized() {
      return request.auth != null
             && (request.auth.token.admin == true || request.auth.token.staff == true);
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ═════════════════════════════════════════════════════════════════════
    //  NIVEL CRÍTICO — solo admin
    //  Control de las PCs, credenciales fiscales y dinero.
    // ═════════════════════════════════════════════════════════════════════

    // ── TERMINAL REMOTA ───────────────────────────────────────────────────
    // La webapp escribe el comando; el POS lo ejecuta con shell=True.
    // Escribir acá es ejecución de código en las PCs de la librería.
    match /remote_terminal/{pcId} {
      allow read, write: if isAdmin();
    }

    // ── COMANDOS REMOTOS POR PC ───────────────────────────────────────────
    // Mismo poder que la terminal: el POS actúa sobre lo que se escriba acá.
    match /pc_commands/{pcId} {
      allow read, write: if isAdmin();
    }

    // ── ESTADO DE PCs (heartbeat) ─────────────────────────────────────────
    // Escribe el POS por Admin SDK. La webapp solo lo lee para el panel de
    // monitoreo, que ya es exclusivo del admin.
    // El alta y la actualizacion las hace solo el POS por Admin SDK; desde la
    // webapp únicamente se borra una PC dada de baja (pcs.js).
    match /pcs/{pcId} {
      allow read, delete:   if isAdmin();
      allow create, update: if false;
    }

    // ── PERFILES ARCA ─────────────────────────────────────────────────────
    // Contienen cert_content / key_content: la clave privada del certificado
    // de facturación. Quien los lea puede facturar en nombre de la librería.
    match /perfiles_facturacion/{docId} {
      allow read, write: if isAdmin();
    }

    // ── CIERRES DE CAJA Y RESÚMENES ───────────────────────────────────────
    match /cierres_caja/{cierreId} {
      allow read, write: if isAdmin();
    }
    match /resumenes_mensuales/{mesId} {
      allow read, write: if isAdmin();
    }

    // ── CONTROL TOTAL (gastos, categorías y config) ───────────────────────
    match /gastos/{gastoId} {
      allow read, write: if isAdmin();
    }
    match /gasto_categorias/{catId} {
      allow read, write: if isAdmin();
    }
    match /control_config/{docId} {
      allow read, write: if isAdmin();
    }
    match /transfer_splits/{fechaId} {
      allow read, write: if isAdmin();
    }

    // ═════════════════════════════════════════════════════════════════════
    //  NIVEL OPERATIVO — lectura con sesión, escritura solo admin
    // ═════════════════════════════════════════════════════════════════════

    // ── CONFIGURACIÓN DEL SISTEMA ─────────────────────────────────────────
    // config/rubros, config/sub_rubros, config/settings, config/emisor_activo.
    match /config/{docId} {
      allow read:  if authorized();
      allow write: if isAdmin();
    }

    // ── PERFILES DE CLIENTES ──────────────────────────────────────────────
    // Datos personales (CUIT, razón social, domicilio) usados en facturación
    // y presupuestos.
    match /clientes_facturacion/{docId} {
      allow read:  if authorized();
      allow write: if isAdmin();
    }

    // ── FACTURAS ELECTRÓNICAS ─────────────────────────────────────────────
    // Las sube el POS con sync_factura() (Admin SDK). La webapp solo consulta.
    match /facturas/{facturaId} {
      allow read:  if authorized();
      allow write: if isAdmin();
    }

    // ── VENTAS ────────────────────────────────────────────────────────────
    // Las genera el POS por Admin SDK. La webapp no debería escribirlas.
    match /ventas/{ventaId} {
      allow read:  if authorized();
      allow write: if isAdmin();
    }
    match /ventas_por_dia/{itemId} {
      allow read:  if authorized();
      allow write: if isAdmin();
    }
    match /historial_diario/{diaId} {
      allow read:  if authorized();
      allow write: if isAdmin();
    }
    match /productos_mas_vendidos/{productoId} {
      allow read:  if authorized();
      allow write: if isAdmin();
    }

    // ── CAJEROS Y CAJA ACTIVA ─────────────────────────────────────────────
    match /cajeros/{docId} {
      allow read:  if authorized();
      allow write: if isAdmin();
    }
    match /caja_activa/{docId} {
      allow read:  if authorized();
      allow write: if isAdmin();
    }
    match /turnos/{turnoId} {
      allow read:  if authorized();
      allow write: if isAdmin();
    }

    // ═════════════════════════════════════════════════════════════════════
    //  NIVEL CATÁLOGO — lectura y escritura con sesión
    //  Trabajo diario de gestión: precios, stock, promos, presupuestos.
    // ═════════════════════════════════════════════════════════════════════

    match /catalogo/{productoId} {
      allow read, write: if authorized();
    }
    match /catalogo_deleted/{productoId} {
      allow read, write: if authorized();
    }
    match /inventario/{productoId} {
      allow read, write: if authorized();
    }
    match /inventario_resumen/{docId} {
      allow read, write: if authorized();
    }

    // ── DESCUENTOS DE LA TIENDA ───────────────────────────────────────────
    // Los define el panel y los aplica el sync. La tienda publica NO los lee:
    // el precio ya rebajado viaja adentro de cada producto, asi que nadie tiene
    // que recalcular nada del lado del cliente.
    match /tienda_descuentos/{descuentoId} {
      allow read:  if authorized();
      allow write: if authorized();
    }

    // ── BORRADORES DE LA TIENDA ───────────────────────────────────────────
    // Fichas armadas de productos que todavía NO salen a la vidriera (su rubro
    // está apagado). La tienda pública no lee esta colección: solo el panel,
    // para decidir qué prender. Las escribe el script por Admin SDK.
    match /tienda_borradores/{productoId} {
      allow read:  if authorized();
      allow write: if isAdmin();
    }

    // ── HISTORIAL DE MOVIMIENTOS DE STOCK ─────────────────────────────────
    // Es el respaldo para reconstruir por qué un stock no cierra: cada entrada
    // y salida con quién, cuándo y de cuánto a cuánto. Se puede leer y agregar,
    // pero NO editar ni borrar — un historial que se puede retocar no sirve
    // como respaldo de nada. El POS escribe por Admin SDK y no pasa por acá.
    match /stock_movimientos/{movId} {
      allow read:   if authorized();
      allow create: if authorized();
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /rubros/{rubroId} {
      allow read, write: if authorized();
    }
    match /sub_categories/{docId} {
      allow read, write: if authorized();
    }
    match /productos_remotos/{productoId} {
      allow read, write: if authorized();
    }
    match /promociones/{promoId} {
      allow read, write: if authorized();
    }

    // ── OBSERVACIONES ─────────────────────────────────────────────────────
    match /observaciones/{obsId} {
      allow read, write: if authorized();
    }
    match /observaciones_meta/{docId} {
      allow read, write: if authorized();
    }

    // ── PRESUPUESTOS ──────────────────────────────────────────────────────
    match /presupuestos/{presId} {
      allow read, write: if authorized();
    }
    match /presupuestos_meta/{docId} {
      allow read, write: if authorized();
    }

    // ── FIADO (cuenta corriente de clientes) ──────────────────────────────
    // El cobro real ocurre en el POS; la webapp administra y carga items.
    match /fiado_clientes/{docId} {
      allow read, write: if authorized();
    }
    match /fiado_items/{docId} {
      allow read, write: if authorized();
    }
    match /fiado_pagos/{docId} {
      allow read, write: if authorized();
    }

    // ── LAB · PRODUCTOS MADRE (módulo aislado, NO toca el POS) ────────────
    match /mp_products/{docId} {
      allow read, write: if authorized();
    }
    match /mp_nodes/{docId} {
      allow read, write: if authorized();
    }
    match /mp_presentations/{docId} {
      allow read, write: if authorized();
    }
    match /mp_discounts/{docId} {
      allow read, write: if authorized();
    }
    match /mp_stock_movements/{docId} {
      allow read, write: if authorized();
    }

    // ═════════════════════════════════════════════════════════════════════
    //  NIVEL PÚBLICO — TIENDA ONLINE
    //  Único punto de la base que se lee sin sesión. Por eso la tienda NUNCA
    //  toca `catalogo`: ahí viven costo, margen y proveedor. Lee un espejo
    //  con solo los campos publicables.
    // ═════════════════════════════════════════════════════════════════════

    // ── ESPEJO PÚBLICO DEL CATÁLOGO ───────────────────────────────────────
    // Lo escribe el panel (al publicar un producto) y el sync del POS
    // (precio y stock). Nadie sin sesión puede modificarlo.
    match /tienda_productos/{productoId} {
      allow read:  if true;
      allow write: if authorized();
    }

    // ── CONFIGURACIÓN DE LA TIENDA ────────────────────────────────────────
    // Horarios, tramos de envío, origen del reparto, textos del sitio.
    // Lectura pública porque la tienda necesita mostrarlos antes del login
    // (que no existe para el cliente).
    match /tienda_config/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── CLIENTES DE LA TIENDA ─────────────────────────────────────────────
    // El perfil de quien se creó una cuenta: nombre, teléfono y direcciones,
    // para no tener que escribirlos en cada pedido.
    //
    // Cada uno ve y escribe el suyo y nada más. Guardarlos bajo el número de
    // teléfono en vez de bajo el uid —que fue la primera idea— habría sido un
    // directorio abierto: los teléfonos se prueban de a miles y cualquiera se
    // llevaría el nombre y la dirección de esa persona.
    //
    // El local los ve desde el panel, que entra con claim.
    // La lectura y la escritura van por separado a propósito: `perfilValido()`
    // mira `request.resource.data`, que en una lectura no existe. Juntas en un
    // `allow read, write`, la condición falla al leer y el dueño no puede ver
    // su propio perfil.
    match /tienda_clientes/{uid} {
      allow read:   if authorized() || esSuyo(uid);
      allow create, update: if esSuyo(uid) && perfilValido();
      allow delete: if esSuyo(uid) || authorized();
    }

    function esSuyo(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function perfilValido() {
      let d = request.resource.data;
      return d.nombre is string && d.nombre.size() <= 80
          && d.telefono is string && d.telefono.size() <= 30
          && (!('direcciones' in d) || (d.direcciones is list && d.direcciones.size() <= 6));
    }

    // ── PEDIDOS ───────────────────────────────────────────────────────────
    // El cliente crea su pedido sin estar autenticado, así que la validación
    // de forma vive acá: es la única barrera entre la colección y cualquiera
    // con la apiKey del bundle.
    //
    //   · `get` abierto / `list` cerrado — el cliente consulta el suyo por ID
    //     exacto (autogenerado, 20 caracteres aleatorios: no se adivina) pero
    //     nadie puede listar la colección y llevarse los datos de todos.
    //   · El estado inicial y los flags operativos se fuerzan acá: un pedido
    //     no puede nacer 'entregado' ni marcado como impreso.
    //   · El total tiene que cerrar contra subtotal + envío.
    //
    // LO QUE ESTO NO PUEDE VALIDAR, Y POR ESO NO ALCANZA
    //
    // Los precios. Un pedido puede entrar con `precio: 1` en una resma de
    // $18.000 y esta función lo acepta: la forma está bien, el total cierra
    // contra el subtotal declarado, y las reglas no pueden leer los cien
    // productos del carrito para comparar (hay un tope de diez `get()` por
    // evaluación). El envío ya se calculaba en el servidor por esta misma
    // razón; los productos, no.
    //
    // Por eso el pedido lo escribe `netlify/functions/crear-pedido`, que
    // relee `tienda_productos`, rehace el total y guarda con la cuenta de
    // servicio, que pasa por encima de estas reglas.
    //
    // PARA CERRAR LA PUERTA (en este orden, y no en otro):
    //
    //   1. Cargar `FIREBASE_SERVICE_ACCOUNT` en el sitio de Netlify de la
    //      tienda (el JSON completo de la cuenta de servicio).
    //   2. Publicar la tienda y confirmar un pedido de prueba.
    //   3. Ver en el pedido que el precio salió de la base.
    //   4. Recién ahí, cambiar `allow create: if pedidoValido()` por
    //      `allow create: if false` y desplegar estas reglas.
    //
    // Invertido, el paso 4 deja la tienda sin poder tomar pedidos: la función
    // contesta 501 mientras le falte la variable y el cliente cae al camino
    // viejo, que es justo el que la regla acaba de cerrar.
    function pedidoValido() {
      let d = request.resource.data;
      return d.keys().hasAll(['estado', 'creado', 'cliente', 'entrega',
                              'items', 'subtotal', 'envio', 'total'])
             && d.estado == 'nuevo'
             && d.creado == request.time
             && d.impreso == false
             && d.visto == false
             && d.cliente.nombre is string
             && d.cliente.nombre.size() >= 2 && d.cliente.nombre.size() <= 80
             && d.cliente.telefono is string
             && d.cliente.telefono.size() >= 6 && d.cliente.telefono.size() <= 30
             && d.entrega.modo in ['delivery', 'retiro']
             && d.items is list
             && d.items.size() >= 1 && d.items.size() <= 100
             && d.subtotal is number && d.subtotal >= 0
             && d.envio is number    && d.envio >= 0
             && d.total is number    && d.total == d.subtotal + d.envio
             && d.nota is string     && d.nota.size() <= 500
             // El pedido puede venir firmado por una cuenta, y entonces tiene
             // que ser la de quien lo está creando: sin esto, cualquiera
             // firmaría pedidos con el uid de otro y se los metería en su
             // historial.
             && (!('uid' in d) || (request.auth != null && d.uid == request.auth.uid));
    }

    match /tienda_pedidos/{pedidoId} {
      allow get:    if true;
      // El local ve todos. Quien tiene cuenta ve los suyos: la consulta que
      // hace la tienda filtra por `uid`, y esta regla se evalúa contra cada
      // documento devuelto, así que una consulta sin ese filtro no pasa.
      allow list:   if authorized()
                    || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if pedidoValido();
      allow update, delete: if authorized();
    }

    // ── COMPROBANTES DE TRANSFERENCIA ─────────────────────────────────────
    // Lo que adjunta el cliente desde la pantalla de su pedido. Va en su propia
    // colección y no adentro del pedido a propósito: el documento del pedido
    // tiene el total y el estado, y esos los toca solo el local. Dejar que el
    // cliente le escriba encima para adjuntar algo abriría esa puerta entera
    // por una función accesoria.
    //
    // El id del documento es el del pedido, así que subir dos veces reemplaza
    // en vez de acumular.
    //
    // `get` es público por lo mismo que en `tienda_pedidos`: el id no se puede
    // adivinar y quien tiene el link del pedido ya ve el total, la dirección y
    // el estado — la vista previa de su propio comprobante no le muestra nada
    // que no sea suyo. Listar sigue siendo solo del local: nadie puede barrer
    // la colección para juntar comprobantes ajenos.
    match /tienda_comprobantes/{pedidoId} {
      allow get: if true;
      allow list: if authorized();
      allow create, update: if comprobanteValido(pedidoId);
      allow delete: if authorized();
    }

    function comprobanteValido(pedidoId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['pedido_id', 'url', 'tipo', 'subido_en'])
          && d.pedido_id is string && d.pedido_id == pedidoId
          && d.url is string && d.url.size() <= 800
          && d.url.matches('https://firebasestorage.googleapis.com/.*')
          && d.tipo in ['imagen', 'pdf']
          && d.subido_en is timestamp;
    }

    // ── FOTOS PEDIDAS ─────────────────────────────────────────────────────
    // Lista de trabajo: los productos a los que hay que sacarles foto. La marca
    // el personal desde la tienda, con el modo oculto (?fotos=1), así que la
    // escritura llega sin sesión igual que un pedido.
    //
    // La lectura es solo del local: quien marca no necesita leerla —la tienda
    // se acuerda de lo suyo en el navegador— y así la lista no queda expuesta.
    //
    // Escribir y borrar quedan abiertos, con la forma validada y el id del
    // documento atado al del producto. Es el mismo trato que `tienda_pedidos`,
    // y acá lo peor que puede pasar es que haya que volver a marcar un
    // producto: no hay dato de nadie ni plata en juego.
    match /tienda_fotos_pedidas/{productoId} {
      allow read: if authorized();
      allow create, update: if fotoPedidaValida(productoId);
      allow delete: if true;
    }

    function fotoPedidaValida(productoId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['producto_id', 'nombre', 'rubro', 'tenia_foto', 'pedido_en'])
          && d.producto_id is string && d.producto_id == productoId
          && d.nombre is string && d.nombre.size() <= 200
          && d.rubro is string && d.rubro.size() <= 60
          && d.tenia_foto is bool
          && d.pedido_en is timestamp;
    }

    // ── BLOQUEAR TODO LO DEMÁS ────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
